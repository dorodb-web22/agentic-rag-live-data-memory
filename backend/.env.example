# Copy this file to .env and fill in a key. Never commit .env.
# Provider: "openai" (default) or "groq"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# SQLite MCP Retrieval (optional: path to local SQLite database file, defaults to data/demo.db)
SQLITE_DB_PATH=data/demo.db

# GitHub MCP Server
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repo

# MCP Configuration
# MCP_TIMEOUT_SECONDS=15.0

# PostgreSQL (shared by LangGraph checkpointer + multi-tenant tables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_rag?sslmode=disable
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# LangSmith Observability & Tracing (Week 6)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-rag-live-data-memory

# Agent safety limits (Week 7)
# Strict graph step limit (clamped to 3-50, default 10)
AGENT_RECURSION_LIMIT=10

# ---- Sprint 1: Auth + Multi-tenant ----
# Google OAuth Web client ID (public — safe to put in frontend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# 32+ char random string — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_32_plus_char_random_string
# Set to "1" in production (HTTPS) to enforce Secure flag on session cookie
COOKIE_SECURE=0
# CORS + CSRF: comma-separated origins allowed for credentialed requests
CORS_ORIGINS=http://localhost:5173,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5500

# ---- Sprint 2: Per-user OAuth Connectors ----
# Fernet key — generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Public base URL of this backend (used to build OAuth redirect URIs)
APP_BASE_URL=http://localhost:8000
# Frontend URL — post-OAuth redirect target
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App (create at github.com/settings/applications/new, callback: APP_BASE_URL/api/integrations/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google connectors (Gmail, Sheets, Calendar) — same Web client as sign-in
# GOOGLE_CLIENT_ID already set above in Sprint 1
GOOGLE_CLIENT_SECRET=

# Notion OAuth Integration (create at notion.so/my-integrations)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# SQLite upload directory (relative to backend working dir)
SQLITE_UPLOAD_DIR=uploads
