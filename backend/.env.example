# Copy this file to .env and fill in a key. Never commit .env.
# Provider: "openai" (default) or "groq"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# SQLite MCP Retrieval (optional: path to local SQLite database file, defaults to data/demo.db)
SQLITE_DB_PATH=data/demo.db
